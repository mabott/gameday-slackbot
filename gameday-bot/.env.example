SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...
ODDS_API_KEY=              # Get free key at https://the-odds-api.com
REDDIT_CLIENT_ID=          # reddit.com/prefs/apps → create app → the ID under the app name
REDDIT_CLIENT_SECRET=      # Secret shown on the same page
REDDIT_USERNAME=           # Your Reddit username
REDDIT_PASSWORD=           # Your Reddit account password (used for script-app OAuth)
ESPN_HIGHLIGHTS=true       # Post ESPN video clips during games (no credentials needed)
REDDIT_HIGHLIGHTS=true     # Post Reddit highlight clips during games (requires credentials above)
ANTHROPIC_API_KEY=sk-ant-...
BLURB_ENABLED=false        # Set to true to enable Claude-generated preview blurbs (requires ANTHROPIC_API_KEY)
TZ=America/Los_Angeles
LOG_LEVEL=INFO
DRY_RUN=false              # Set to true to print posts to stdout instead of Slack
DB_PATH=gameday.db
ESPN_ID_CACHE_PATH=espn_ids.json
